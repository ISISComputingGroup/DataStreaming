{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detector to spectrum mapping",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "det": {
        "type": "integer",
        "minimum": 0,
        "description": "Detector ID"
      },
      "spec": {
        "type": "integer",
        "minimum": 0,
        "description": "Spectrum number"
      }
    },
    "required": ["detector", "spectrum"],
    "additionalProperties": false
  }
}
